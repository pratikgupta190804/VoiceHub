# AI Detection Service Configuration
# Add these environment variables to your .env file

# Enable/disable AI detection
AI_DETECTION_ENABLED=true

# Action to take when AI detection fails: continue, flag, block
AI_DETECTION_FAILURE_ACTION=continue

# AI or Not API Configuration
# Get your API key from: https://aiornot.com/
# Free tier: 100 requests/month
# Paid plans available for higher volumes
AI_OR_NOT_API_KEY=your_ai_or_not_api_key_here

# Hive AI API Configuration  
# Get your API key from: https://thehive.ai/
# Content moderation with AI detection capabilities
# Pricing based on number of requests
HIVE_AI_API_KEY=your_hive_ai_api_key_here

# Sensity AI Configuration
# Get your API key from: https://sensity.ai/
# Specialized in deepfake and face manipulation detection
# Enterprise-focused pricing
SENSITY_AI_API_KEY=your_sensity_ai_api_key_here

# Detection Thresholds (0.0 - 1.0)
AI_DETECTION_BLOCKING_THRESHOLD=0.8
AI_DETECTION_FLAGGING_THRESHOLD=0.5

# Default providers to use (comma-separated)
# Options: aiornot,hiveai,sensityai
AI_DETECTION_DEFAULT_PROVIDERS=aiornot